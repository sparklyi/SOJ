# Environment for the Compose stack. Most configuration lives in
# deploy/config.yaml; the file declares the placeholders it accepts, and this
# file supplies their values. Copy it to .env (or point --env-file at it) and
# replace every secret.
#
# The only variable the loader itself reads is SOJ_CONFIG_FILE, which names the
# configuration file. It is set by the Compose files.
SOJ_ENV=docker

# Secrets. Required by the api/worker/migrate commands and the judge agent's
# object storage access; never commit real values.
SOJ_DATABASE_DSN=postgres://soj:soj@postgres:5432/soj?sslmode=disable
SOJ_JWT_SECRET=local-dev-secret-change-me
SOJ_STORAGE_ACCESS_KEY=minioadmin
SOJ_STORAGE_SECRET_KEY=minioadmin

# Judge routing. deploy/docker-compose.docker-runner.yaml switches these to
# agent://local + docker automatically.
SOJ_JUDGE_ENDPOINT=fake://accepted
SOJ_JUDGE_SANDBOX_BACKEND=fake
# SOJ_JUDGE_AGENT_STREAMS=all

# Judge agent capacity and self-run limits; the configuration file defaults to
# parallelism 1, no language slots, max_batch 16, two runs per user.
# SOJ_JUDGE_PARALLELISM=1
# SOJ_JUDGE_LANGUAGE_SLOTS=go=1,cpp17=1
# SOJ_JUDGE_MAX_BATCH=1
# SOJ_JUDGE_RUN_PARALLELISM=1
# SOJ_JUDGE_RUN_PER_USER=2

# Self-run retention sweep (days, interval, batch).
# SOJ_RUN_RETENTION_DAYS=7
# SOJ_RUN_RETENTION_INTERVAL=10m
# SOJ_RUN_RETENTION_BATCH=200

# Docker runner (used by the docker-runner overlay and production).
# SOJ_DOCKER_RUNNER_RUNTIME=runsc
# SOJ_DOCKER_RUNNER_WORKDIR=/var/lib/soj/runner-work
# SOJ_DOCKER_RUNNER_IMAGE_GO=ghcr.io/sparklyi/soj-runner-go:main
# SOJ_DOCKER_RUNNER_IMAGE_CPP17=ghcr.io/sparklyi/soj-runner-cpp17:main

# Tracing is off unless enabled.
# SOJ_TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://collector:4318/v1/traces
# OTEL_SERVICE_NAME=soj-api
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod
