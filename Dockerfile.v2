FROM golang:1.25-alpine AS builder

WORKDIR /src
RUN apk add --no-cache ca-certificates git

COPY go.mod go.sum ./
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}
RUN go mod download

COPY . .

# Build every command in one step. All four compose services build from this
# stage, and BuildKit deduplicates identical stages, so the module is compiled
# once instead of once per service. The runtime stage below picks its binary by
# COMMAND; the argument is deliberately not read here, or it would split this
# stage into one copy per service and bring the duplicate builds back.
#
# The build cache lives in a cache mount, not in the layer: it is hundreds of
# megabytes, and it can only be reused while the source tree is byte-identical,
# so exporting it to the CI cache costs more than it saves. The mount still
# makes repeated local builds incremental.
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/ ./cmd/...

FROM alpine:3.24

ARG COMMAND=soj-api
RUN apk add --no-cache ca-certificates tzdata \
    && if [ "$COMMAND" = "soj-judge-agent" ]; then \
        apk add --no-cache docker-cli go g++ musl-dev; \
    fi
WORKDIR /app

COPY --from=builder /out/${COMMAND} /app/soj
COPY internal/migrations /app/internal/migrations

ENV SOJ_MIGRATIONS_DIR=/app/internal/migrations
EXPOSE 8080 8081 8082

ENTRYPOINT ["/app/soj"]
